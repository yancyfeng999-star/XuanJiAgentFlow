{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "璇玑",
  "version": "0.3.1",
  "identifier": "com.xuanji.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "sh -c 'mkdir -p ../.tmp-build-backups && if [ -d dist ]; then mv dist ../.tmp-build-backups/dist.tauri.$$; fi && npm run build'"
  },
  "app": {
    "windows": [
      {
        "title": "璇玑 · 智能任务协作",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/xuanji-coordinator"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDMUZDM0EzOEE3MTQxNDYKUldSR1FYR0tvOE1mM0JUYlJ2ZlRibmhqTlorSzBwbWhlM0FpeGU1Mi9SekYvUi9seU9mYWl4ZWgK",
      "endpoints": [
        "https://github.com/yancyfeng999-star/XuanJiAgentFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
