{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "璇玑",
  "version": "0.3.2",
  "identifier": "com.xuanji.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "sh -c 'mkdir -p ../.tmp-build-backups && if [ -d dist ]; then mv dist ../.tmp-build-backups/dist.tauri.$$; fi && npm run build'"
  },
  "app": {
    "windows": [
      {
        "title": "璇玑 · 智能任务协作",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* http://localhost:* ws://localhost:*; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/xuanji-coordinator"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDMUZDM0EzOEE3MTQxNDYKUldSR1FYR0tvOE1mM0JUYlJ2ZlRibmhqTlorSzBwbWhlM0FpeGU1Mi9SekYvUi9seU9mYWl4ZWgK",
      "endpoints": [
        "https://github.com/yancyfeng999-star/XuanJiAgentFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
