#!/usr/bin/env bash
# Development/local packaging sidecar wrapper.
# Production releases should replace this with a PyInstaller binary
# (see backend/xuanji-coordinator.spec and binaries/README.md).
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# app/src-tauri/binaries -> repo root is ../../../
ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
PY="${XUANJI_PYTHON:-}"
if [[ -z "$PY" ]]; then
  if [[ -x "$ROOT/.venv/bin/python" ]]; then
    PY="$ROOT/.venv/bin/python"
  elif [[ -x "$ROOT/backend/.venv/bin/python" ]]; then
    PY="$ROOT/backend/.venv/bin/python"
  else
    PY="$(command -v python3)"
  fi
fi

export PYTHONPATH="${ROOT}/backend/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m xuanji "$@"
